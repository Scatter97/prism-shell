import { Icons } from "../icons.slint";
import { Tokens } from "../tokens.slint";
import { UiState } from "../state.slint";
import { AppGlyph, Icon } from "icon.slint";

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <image> glyph: Icons.window;
    in property <bool> selected: false;

    height: 28px;
    border-radius: 7px;
    background: root.selected ? rgba(137, 168, 255, 0.12) : #00000000;

    Icon {
        x: 9px;
        y: (parent.height - self.height) / 2;
        width: 13px;
        height: 13px;
        glyph: root.glyph;
        tint: root.selected ? Tokens.accent : Tokens.text-tertiary;
    }
    Text {
        x: 30px;
        y: 0px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.label;
        color: root.selected ? Tokens.text-primary : Tokens.text-secondary;
        font-size: Tokens.type-caption;
        vertical-alignment: center;
    }
}

component StatCard inherits Rectangle {
    in property <image> glyph: Icons.focus;
    in property <string> title: "";
    in property <string> value: "";
    in property <color> tint: Tokens.accent;

    height: 74px;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.035);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.065);

    Rectangle {
        x: 10px;
        y: 10px;
        width: 24px;
        height: 24px;
        border-radius: 7px;
        background: rgba(255, 255, 255, 0.045);
        Icon {
            width: 13px;
            height: 13px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            glyph: root.glyph;
            tint: root.tint;
        }
    }
    Text {
        x: 10px;
        y: 41px;
        text: root.title;
        color: Tokens.text-tertiary;
        font-size: 8.5px;
        letter-spacing: 0.4px;
    }
    Text {
        x: 10px;
        y: 51px;
        width: parent.width - 20px;
        height: 16px;
        text: root.value;
        color: Tokens.text-primary;
        font-size: Tokens.type-caption;
        font-weight: Tokens.weight-medium;
        overflow: elide;
    }
}

export component DesktopMock inherits Rectangle {
    border-radius: 16px;
    background: rgba(10, 15, 24, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.105);
    drop-shadow-blur: 42px;
    drop-shadow-color: rgba(0, 0, 0, 0.34);
    drop-shadow-offset-y: 18px;
    clip: true;

    // Window chrome. Absolute positions keep this decorative mock independent
    // of any layout quirks in the surrounding preview stage.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 42px;
        background: rgba(22, 28, 40, 0.82);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.06);

        Rectangle {
            x: 14px;
            y: 7px;
            width: 132px;
            height: 28px;
            border-top-left-radius: 7px;
            border-top-right-radius: 7px;
            background: rgba(12, 17, 27, 0.78);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.07);

            AppGlyph {
                x: 8px;
                y: 7px;
                width: 14px;
                height: 14px;
                kind: "browser";
            }
            Text {
                x: 28px;
                y: 0px;
                width: parent.width - 48px;
                height: parent.height;
                text: "Prism — Overview";
                color: Tokens.text-secondary;
                font-size: 9px;
                vertical-alignment: center;
                overflow: elide;
            }
            Icon {
                x: parent.width - 17px;
                y: 10px;
                width: 8px;
                height: 8px;
                glyph: Icons.close;
                tint: Tokens.text-tertiary;
            }
        }

        Text {
            x: 160px;
            y: 0px;
            width: 58px;
            height: 42px;
            text: "Journal";
            color: Tokens.text-tertiary;
            font-size: 9px;
            vertical-alignment: center;
        }

        // Windows-style caption controls, drawn as static mock chrome.
        Icon {
            x: parent.width - 62px;
            y: 17px;
            width: 9px;
            height: 9px;
            glyph: Icons.minus;
            tint: Tokens.text-tertiary;
        }
        Rectangle {
            x: parent.width - 43px;
            y: 17px;
            width: 8px;
            height: 8px;
            border-width: 1px;
            border-color: Tokens.text-tertiary;
            background: transparent;
        }
        Icon {
            x: parent.width - 23px;
            y: 17px;
            width: 9px;
            height: 9px;
            glyph: Icons.close;
            tint: Tokens.text-tertiary;
        }
    }

    // Toolbar
    Rectangle {
        x: 0px;
        y: 42px;
        width: parent.width;
        height: 38px;
        background: rgba(15, 20, 31, 0.64);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.045);

        Icon {
            x: 16px;
            y: (parent.height - self.height) / 2;
            width: 13px;
            height: 13px;
            glyph: Icons.chevron;
            tint: Tokens.text-tertiary;
            transform-rotation: 180deg;
        }
        Icon {
            x: 36px;
            y: (parent.height - self.height) / 2;
            width: 13px;
            height: 13px;
            glyph: Icons.chevron;
            tint: Tokens.text-tertiary;
        }
        Icon {
            x: 56px;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            glyph: Icons.refresh;
            tint: Tokens.text-tertiary;
        }

        Rectangle {
            x: 82px;
            y: 7px;
            width: parent.width - 124px;
            height: 24px;
            border-radius: 7px;
            background: rgba(5, 9, 16, 0.45);
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.06);

            Icon {
                x: 9px;
                y: (parent.height - self.height) / 2;
                width: 10px;
                height: 10px;
                glyph: Icons.lock;
                tint: Tokens.success;
            }
            Text {
                x: 25px;
                y: 0px;
                width: parent.width - 34px;
                height: parent.height;
                text: "prism.shell / overview";
                color: Tokens.text-tertiary;
                font-size: 9px;
                vertical-alignment: center;
            }
        }
    }

    // Sidebar
    Rectangle {
        x: 0px;
        y: 80px;
        width: 162px;
        height: parent.height - 80px;
        background: rgba(13, 18, 28, 0.55);
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.04);

        Text {
            x: 14px;
            y: 14px;
            text: "WORKSPACE";
            color: Tokens.text-tertiary;
            font-size: 7.5px;
            font-weight: Tokens.weight-semibold;
            letter-spacing: 0.7px;
        }

        VerticalLayout {
            x: 10px;
            y: 32px;
            width: 142px;
            spacing: 2px;

            NavItem { label: "Overview"; glyph: Icons.window; selected: true; }
            NavItem { label: "Applications"; glyph: Icons.apps; }
            NavItem { label: "Focus"; glyph: Icons.focus; }
            NavItem { label: "Sound"; glyph: Icons.volume; }
            NavItem { label: "Display"; glyph: Icons.display; }
        }

        Rectangle {
            x: 10px;
            y: parent.height - 34px;
            width: 142px;
            height: 24px;
            border-radius: 7px;
            background: rgba(255, 255, 255, 0.03);
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: "Static mock content";
                color: Tokens.text-tertiary;
                font-size: 8px;
                vertical-alignment: center;
            }
        }
    }

    // Main content
    Rectangle {
        x: 162px;
        y: 80px;
        width: parent.width - 162px;
        height: parent.height - 80px;
        background: @linear-gradient(145deg, rgba(19, 26, 42, 0.52), rgba(12, 17, 27, 0.18));

        Text {
            x: 34px;
            y: 32px;
            text: "PRISM SHELL / CONCEPT";
            color: Tokens.accent;
            font-size: 8.5px;
            font-weight: Tokens.weight-semibold;
            letter-spacing: 1.2px;
        }

        Text {
            x: 34px;
            y: 50px;
            width: parent.width - 260px;
            height: 46px;
            text: "A calmer desktop.";
            color: Tokens.text-primary;
            font-size: 34px;
            font-weight: Tokens.weight-semibold;
            letter-spacing: -0.6px;
            vertical-alignment: center;
        }

        Text {
            x: 35px;
            y: 100px;
            width: 360px;
            height: 44px;
            text: "One floating surface for the apps you use, the controls you need, and the moment you are in.";
            color: Tokens.text-secondary;
            font-size: Tokens.type-small;
            wrap: word-wrap;
            line-height-factor: 1.35;
        }

        HorizontalLayout {
            x: 34px;
            y: 162px;
            width: parent.width - 68px;
            height: 74px;
            spacing: 10px;

            StatCard { width: 126px; glyph: Icons.focus; title: "FOCUS"; value: "Clear"; tint: Tokens.accent-violet; }
            StatCard { width: 126px; glyph: Icons.volume; title: "SOUND"; value: UiState.audio-available ? UiState.audio-device : "No output"; tint: Tokens.accent; }
            StatCard { width: 126px; glyph: Icons.sun; title: "DISPLAY"; value: UiState.brightness-available ? round(UiState.brightness) + "% brightness" : "Not controllable"; tint: Tokens.warning; }
        }

        // Abstract aurora / prism composition. It is deliberately graphic, not
        // a fake screenshot of a real service.
        Rectangle {
            x: parent.width - 300px;
            y: 34px;
            width: 254px;
            height: 250px;
            border-radius: 22px;
            background: @linear-gradient(145deg, rgba(89, 109, 190, 0.28), rgba(156, 106, 190, 0.22));
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.08);
            clip: true;

            Rectangle {
                x: 116px;
                y: -60px;
                width: 190px;
                height: 190px;
                border-radius: 95px;
                background: rgba(137, 168, 255, 0.18);
                drop-shadow-blur: 40px;
                drop-shadow-color: rgba(137, 168, 255, 0.22);
            }
            Rectangle {
                x: -50px;
                y: 130px;
                width: 210px;
                height: 210px;
                border-radius: 105px;
                background: rgba(180, 139, 255, 0.14);
                drop-shadow-blur: 42px;
                drop-shadow-color: rgba(180, 139, 255, 0.18);
            }
            Image {
                width: 86px;
                height: 86px;
                x: (parent.width - self.width) / 2;
                y: 72px;
                source: Icons.prism;
                image-fit: contain;
            }
            Text {
                x: 20px;
                y: parent.height - 54px;
                width: parent.width - 40px;
                height: 20px;
                text: "A preview of the surface, not the system.";
                color: rgba(245, 247, 250, 0.66);
                font-size: 8.5px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 34px;
            y: parent.height - 42px;
            width: parent.width - 68px;
            height: 18px;
            text: "Concept window · static mock content · no application is running";
            color: rgba(166, 175, 191, 0.5);
            font-size: 8px;
            vertical-alignment: center;
        }
    }
}
