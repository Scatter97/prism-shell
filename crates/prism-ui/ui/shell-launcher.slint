import { Tokens } from "tokens.slint";
import { UiState } from "state.slint";
import { Launcher } from "components/launcher.slint";

// Production launcher window. It is a real application launcher, not a Start
// menu replacement; the Windows Start menu remains available.
export component ShellLauncher inherits Window {
    title: "Prism Applications";
    width: 360px + 48px;
    height: 452px + 48px;
    no-frame: true;
    always-on-top: true;
    background: #00000000;
    default-font-family: Tokens.font-family;
    default-font-size: Tokens.type-body;
    default-font-weight: Tokens.weight-regular;

    key-root := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                UiState.close-launcher();
                return accept;
            }
            reject
        }

        Launcher {
            x: 24px;
            y: 24px;
        }
    }

    init => {
        key-root.focus();
    }
}
